# =============================================================================
# 16. CLOVERFACTORY SYSTEMD SERVICE
# =============================================================================
echo "[industrial] Creating CloverFactory service..."

cat > /etc/systemd/system/cloverfactory.service <<'SERVICE'
[Unit]
Description=CloverFactory Industrial Platform
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/cloverfactory/scripts/cloverfactory-startup.sh
ExecStop=/opt/cloverfactory/scripts/cloverfactory-shutdown.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
SERVICE

cat > /opt/cloverfactory/scripts/cloverfactory-startup.sh <<'STARTUP'
#!/bin/bash
echo "[cloverfactory] Starting CloverFactory Industrial Platform..."

source /etc/myclover/cloverfactory.d/industrial.conf 2>/dev/null || true

# Start MQTT broker
systemctl start mosquitto 2>/dev/null || true

# Install + start Node-RED
/opt/cloverfactory/scripts/install-nodered.sh 2>/dev/null || true
systemctl start nodered 2>/dev/null || true

# Install + start InfluxDB
/opt/cloverfactory/scripts/install-influxdb.sh 2>/dev/null || true
systemctl start influxdb 2>/dev/null || true

# Install + start Grafana
/opt/cloverfactory/scripts/install-grafana.sh 2>/dev/null || true
systemctl start grafana-server 2>/dev/null || true

# Start Modbus gateway (if configured)
if [[ -f /etc/myclover/cloverfactory.d/modbus-devices.json ]]; then
    systemctl start cloverfactory-modbus 2>/dev/null || true
fi

# Start alarm engine (if configured)
if [[ -f /etc/myclover/cloverfactory.d/alarm-rules.json ]]; then
    systemctl start cloverfactory-alarm 2>/dev/null || true
fi

# OT network segmentation
/opt/cloverfactory/scripts/setup-network-segmentation.sh 2>/dev/null || true

# Start Cockpit web UI
systemctl start cockpit.socket 2>/dev/null || true

echo "[cloverfactory] CloverFactory ready"
STARTUP
chmod +x /opt/cloverfactory/scripts/cloverfactory-startup.sh

cat > /opt/cloverfactory/scripts/cloverfactory-shutdown.sh <<'SHUTDOWN'
#!/bin/bash
echo "[cloverfactory] Shutting down CloverFactory..."
echo "[cloverfactory] Shutdown complete"
SHUTDOWN
chmod +x /opt/cloverfactory/scripts/cloverfactory-shutdown.sh

systemctl enable cloverfactory.service 2>/dev/null || true
systemctl enable mosquitto.service 2>/dev/null || true

echo "[industrial] Industrial Edition chroot hook complete"
echo "[industrial] MQTT, Node-RED, InfluxDB, Grafana, Modbus, OT segmentation configured"
