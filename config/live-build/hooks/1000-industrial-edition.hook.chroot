# =============================================================================
# 11. WATCHDOG SERVICE
# =============================================================================
echo "[industrial] Configuring watchdog..."

cat > /etc/watchdog.conf <<'WDCONF'
# CloverFactory Industrial Watchdog
watchdog-device = /dev/watchdog
watchdog-timeout = 60
interval = 10
realtime = yes
priority = 1

# Monitor critical services
pidfile = /run/mosquitto/mosquitto.pid
pidfile = /run/nodered.pid

# Test network connectivity
ping = 127.0.0.1
interface = eth0

# Test disk space
file = /var/log/cloverfactory
change = 86400

# Max load
max-load-1 = 24
max-load-5 = 18
min-memory = 1
WDCONF

systemctl enable watchdog 2>/dev/null || true

# =============================================================================
# 12. AUDIT LOGGING (ICS compliance)
# =============================================================================
echo "[industrial] Configuring audit logging..."

cat > /etc/audit/rules.d/cloverfactory.rules <<'AUDITRULES'
# CloverFactory Industrial Audit Rules (IEC 62443 / NIST 800-82)

# Monitor config changes
-w /etc/myclover/cloverfactory.d/ -p wa -k cloverfactory_config
-w /etc/mosquitto/ -p wa -k mqtt_config
-w /opt/cloverfactory/flows/ -p wa -k nodered_flows

# Monitor network changes
-w /etc/nftables.conf -p wa -k firewall
-w /etc/network/ -p wa -k network

# Monitor user/auth changes
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity

# Monitor privileged commands
-a always,exit -F arch=b64 -S execve -F euid=0 -k privileged_cmd

# Monitor Modbus/OPC-UA ports
-a always,exit -F arch=b64 -S connect -F a2=2 -k network_connect
AUDITRULES

systemctl enable auditd 2>/dev/null || true

