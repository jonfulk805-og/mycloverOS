# =============================================================================
# 14. KERNEL TUNING (real-time / deterministic)
# =============================================================================
echo "[industrial] Applying industrial kernel tuning..."

cat > /etc/sysctl.d/90-cloverfactory.conf <<'SYSCTL'
# CloverFactory Industrial — Deterministic / Low-Latency

# Network
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_timestamps = 1

# Real-time scheduling
kernel.sched_rt_runtime_us = 950000

# Watchdog
kernel.nmi_watchdog = 1
kernel.soft_watchdog = 1

# File limits
fs.file-max = 1048576
fs.inotify.max_user_watches = 524288

# VM tuning
vm.swappiness = 10
SYSCTL

