# =============================================================================
# 14. CONSOLE BANNER
# =============================================================================
echo "[hypervisor] Setting up console banner..."

cat > /etc/issue <<'ISSUE'

    ╔══════════════════════════════════════════════════════════════╗
    ║                                                              ║
    ║   ☘  CloverVisor -- Hypervisor Blackbox Edition              ║
    ║      MyClover.Tech CloverOS                                  ║
    ║                                                              ║
    ║   Web UI:   https://<IP>:8006                                ║
    ║   Docs:     https://docs.myclover.tech/clovervisor           ║
    ║                                                              ║
    ║   SSH is DISABLED by default (blackbox mode)                 ║
    ║   Enable via Web UI > Settings > SSH Access                  ║
    ║                                                              ║
    ╚══════════════════════════════════════════════════════════════╝

ISSUE

# Also write MOTD for emergency console
cat > /etc/motd <<'MOTD'

  ☘  CloverVisor Emergency Console
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  Web UI:  https://$(hostname -I | awk '{print $1}'):8006
  Status:  clovervisor status
  Help:    clovervisor --help

MOTD

echo "[hypervisor] Hypervisor Blackbox chroot hook complete"
echo "[hypervisor] KVM/QEMU, libvirt, OVS, ZFS, Cockpit, hardening -- all configured"
