#!/bin/bash
# =============================================================================
# mycloverOS chroot hook -- Install CloverOS Service Hub
# Web dashboard + API for managing all CloverStack services, deploy apps,
# and containerized desktops. Runs on port 7777.
# =============================================================================
set -e

echo "[clover-hub] Installing CloverOS Service Hub..."

# --- Create directory structure ---
mkdir -p /opt/cloverstack/hub

# --- Install the API server ---
# (clover-hub-api.py and index.html are placed by the overlay)
# Just verify they exist and set permissions
if [ -f /opt/cloverstack/hub/clover-hub-api.py ]; then
    chmod +x /opt/cloverstack/hub/clover-hub-api.py
    echo "[clover-hub] API server found in overlay"
else
    echo "[clover-hub] WARNING: clover-hub-api.py not in overlay, will need manual install"
fi

# --- Systemd service ---
cat > /etc/systemd/system/clover-hub.service <<'EOF'
[Unit]
Description=CloverOS Service Hub Dashboard
Documentation=https://myclover.tech
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/cloverstack/hub/clover-hub-api.py
WorkingDirectory=/opt/cloverstack/hub
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

systemctl enable clover-hub 2>/dev/null || true

# --- Desktop shortcut (system-wide) ---
mkdir -p /usr/share/applications
cat > /usr/share/applications/clover-hub.desktop <<'DESKTOP'
[Desktop Entry]
Version=1.0
Type=Application
Name=CloverOS Service Hub
Comment=Manage all CloverStack services, apps, and desktops
Exec=xdg-open http://localhost:7777
Icon=preferences-system-network
Terminal=false
Categories=System;Monitor;Network;
Keywords=clover;services;docker;dashboard;hub;
StartupNotify=true
DESKTOP

# --- Add to default desktop for all editions ---
# Skeleton directory ensures new users get the shortcut
mkdir -p /etc/skel/Desktop
cp /usr/share/applications/clover-hub.desktop /etc/skel/Desktop/
chmod +x /etc/skel/Desktop/clover-hub.desktop

# Also add to existing clover user desktop
mkdir -p /home/clover/Desktop
cp /usr/share/applications/clover-hub.desktop /home/clover/Desktop/
chmod +x /home/clover/Desktop/clover-hub.desktop
chown -R 1000:1000 /home/clover/Desktop/ 2>/dev/null || true

# --- Base deploy catalog (all editions) ---
# Create a starter catalog so the Service Hub's deploy tab works.
# The NAS edition (0300) overwrites this with its richer catalog.
mkdir -p /opt/cloverstack/cloverdeploy/catalog
if [ ! -f /opt/cloverstack/cloverdeploy/catalog/manifest.json ]; then
cat > /opt/cloverstack/cloverdeploy/catalog/manifest.json <<'BASECATALOG'
{
  "version": "1.0.0",
  "updated": "2025-01-01T00:00:00Z",
  "categories": [
    {
      "name": "Productivity",
      "apps": [
        {"id": "nextcloud", "name": "Nextcloud", "desc": "File sync, calendar, contacts", "image": "nextcloud:latest", "ports": [8080], "ha": true},
        {"id": "onlyoffice", "name": "OnlyOffice", "desc": "Document editor suite", "image": "onlyoffice/documentserver:latest", "ports": [8081], "ha": false},
        {"id": "vaultwarden", "name": "Vaultwarden", "desc": "Password manager (Bitwarden compatible)", "image": "vaultwarden/server:latest", "ports": [8082], "ha": true},
        {"id": "bookstack", "name": "BookStack", "desc": "Wiki & documentation", "image": "lscr.io/linuxserver/bookstack:latest", "ports": [8083], "ha": false}
      ]
    },
    {
      "name": "Media",
      "apps": [
        {"id": "plex", "name": "Plex", "desc": "Media server", "image": "plexinc/pms-docker:latest", "ports": [32400], "ha": false},
        {"id": "jellyfin", "name": "Jellyfin", "desc": "Free media server", "image": "jellyfin/jellyfin:latest", "ports": [8096], "ha": false},
        {"id": "photoprism", "name": "PhotoPrism", "desc": "AI-powered photo management", "image": "photoprism/photoprism:latest", "ports": [2342], "ha": false}
      ]
    },
    {
      "name": "Networking",
      "apps": [
        {"id": "pihole", "name": "Pi-hole", "desc": "DNS-level ad blocking", "image": "pihole/pihole:latest", "ports": [53, 8084], "ha": true},
        {"id": "wireguard-ui", "name": "WireGuard UI", "desc": "VPN management", "image": "ngoduykhanh/wireguard-ui:latest", "ports": [5000], "ha": false},
        {"id": "tailscale", "name": "Tailscale", "desc": "Zero-config VPN mesh", "image": "tailscale/tailscale:latest", "ports": [], "ha": false}
      ]
    },
    {
      "name": "Monitoring",
      "apps": [
        {"id": "grafana", "name": "Grafana", "desc": "Dashboards & visualization", "image": "grafana/grafana:latest", "ports": [3000], "ha": false},
        {"id": "uptime-kuma", "name": "Uptime Kuma", "desc": "Uptime monitoring", "image": "louislam/uptime-kuma:latest", "ports": [3001], "ha": true},
        {"id": "netdata", "name": "Netdata", "desc": "Real-time performance monitoring", "image": "netdata/netdata:latest", "ports": [19999], "ha": false}
      ]
    },
    {
      "name": "Development",
      "apps": [
        {"id": "gitea", "name": "Gitea", "desc": "Self-hosted Git", "image": "gitea/gitea:latest", "ports": [3002], "ha": true},
        {"id": "codeserver", "name": "Code Server", "desc": "VS Code in the browser", "image": "lscr.io/linuxserver/code-server:latest", "ports": [8443], "ha": false}
      ]
    },
    {
      "name": "AI / Machine Learning",
      "apps": [
        {"id": "ollama", "name": "Ollama", "desc": "Local LLM inference", "image": "ollama/ollama:latest", "ports": [11434], "ha": false},
        {"id": "openwebui", "name": "Open WebUI", "desc": "ChatGPT-like interface for Ollama", "image": "ghcr.io/open-webui/open-webui:main", "ports": [3003], "ha": false},
        {"id": "localai", "name": "LocalAI", "desc": "OpenAI-compatible local API", "image": "localai/localai:latest", "ports": [8088], "ha": false}
      ]
    },
    {
      "name": "Home Automation",
      "apps": [
        {"id": "homeassistant", "name": "Home Assistant", "desc": "Smart home control", "image": "ghcr.io/home-assistant/home-assistant:stable", "ports": [8123], "ha": false},
        {"id": "nodered", "name": "Node-RED", "desc": "Flow-based automation", "image": "nodered/node-red:latest", "ports": [1880], "ha": false}
      ]
    }
  ]
}
BASECATALOG
fi

# --- Firewall rule ---
mkdir -p /etc/myclover/firewall-rules.d
cat >> /etc/myclover/firewall-rules.d/clover-hub.rules 2>/dev/null <<'EOF' || true
# CloverOS Service Hub -- dashboard port
ufw allow 7777/tcp comment 'CloverOS Service Hub'
EOF

# --- Add to MOTD ---
# Append hub URL to the existing MOTD
if [ -f /etc/motd ]; then
    sed -i '/Service Hub/d' /etc/motd
    sed -i '/After setup/i\  Service Hub: http://<this-ip>:7777' /etc/motd 2>/dev/null || true
fi

echo "[clover-hub] CloverOS Service Hub installed."
echo "[clover-hub] Dashboard will be at http://<ip>:7777 after boot."
