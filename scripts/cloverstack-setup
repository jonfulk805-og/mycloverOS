#!/usr/bin/env bash
# =============================================================================
# cloverstack-setup -- CloverStack service orchestrator
# Manages Docker Compose stacks for each CloverStack module
# =============================================================================
set -euo pipefail

CLOVERSTACK_ROOT="/opt/cloverstack"
CLOVERSTACK_CONFIG="/etc/myclover"
MODULES_DIR="${CLOVERSTACK_CONFIG}/modules.d"

log() { echo "[cloverstack] $*"; }
err() { echo "[cloverstack] ERROR: $*" >&2; }

usage() {
    cat <<EOF
Usage: cloverstack-ctl <command> [module|subcommand]

Platform Commands:
  storage <subcommand>    CloverNAS storage management (ZFS, shares, disks)
  deploy <subcommand>     CloverDeploy container & VM orchestration
  mesh <subcommand>       CloverMesh cluster management ("Fail to Anywhere")

Module Commands:
  status              Show status of all modules
  enable <module>     Enable a module
  disable <module>    Disable a module
  start <module>      Start a module
  stop <module>       Stop a module
  restart <module>    Restart a module
  logs <module>       Show module logs
  list                List all available modules
  info <module>       Show module info

Marketplace:
  market browse       Browse CloverMarket apps
  market install <id> Install a CloverApp
  market status       Show installed CloverApps
  market wizard <id>  Run app startup wizard
  market theme <cmd>  Manage themes (list|apply|import)

Modules:
  netmon              Network monitoring (Zabbix)
  sentrylog           Log management (Graylog + Wazuh)
  myclover-vault      Password manager (Vaultwarden)
  chappie             AI assistant (Ollama + Open WebUI)
  chatbox-team        Shared AI API proxy (Chatbox Team)
  anythingllm         AI chat + document workspaces (AnythingLLM)
  clovermarket        App marketplace (CloverMarket)
  clovermedia         Smart TV + streaming + DJ
  cloversign          Digital signage
  cloverguard         Web proxy + content filter
  clovermine          Crypto mining
  cloverpos           Point of sale
  cloverdesign        AI design studio
  cloverbot           AI support chatbot (LibreChat)
  cloverdrone         UAV control
  clovermesh          Distributed mesh
  clovermesh-radio    LoRa mesh comms
  streamserver        Live streaming platform

Examples:
  cloverstack-ctl storage pool create tank mirror /dev/sda /dev/sdb
  cloverstack-ctl deploy install nextcloud --ha
  cloverstack-ctl mesh init --name my-cluster --node-ip 192.168.1.10
  cloverstack-ctl mesh status

EOF
}

cmd_status() {
    echo ""
    echo "CloverStack Module Status"
    echo "========================="
    echo ""
    printf "%-20s %-10s %-10s\n" "MODULE" "ENABLED" "RUNNING"
    printf "%-20s %-10s %-10s\n" "------" "-------" "-------"

    for mod_dir in "${CLOVERSTACK_ROOT}/modules/"*/; do
        [[ -d "${mod_dir}" ]] || continue
        mod=$(basename "${mod_dir}")
        
        if [[ -f "${MODULES_DIR}/${mod}.enabled" ]]; then
            enabled="yes"
        else
            enabled="no"
        fi

        if docker compose -f "${mod_dir}/docker-compose.yml" ps --status running -q 2>/dev/null | grep -q .; then
            running="yes"
        else
            running="no"
        fi

        printf "%-20s %-10s %-10s\n" "${mod}" "${enabled}" "${running}"
    done
    echo ""
}

cmd_enable() {
    local mod="$1"
    mkdir -p "${MODULES_DIR}"
    touch "${MODULES_DIR}/${mod}.enabled"
    log "Enabled: ${mod}"
    cmd_start "${mod}"
}

cmd_disable() {
    local mod="$1"
    cmd_stop "${mod}"
    rm -f "${MODULES_DIR}/${mod}.enabled"
    log "Disabled: ${mod}"
}

# --- Per-module secrets -----------------------------------------------------
# Nothing secret ships in the public repo. Compose reads <module>/.env, which
# is created here (0600) the first time the module starts.
SENTRYLOG_ADMIN_SHA256_DEFAULT="8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918"  # sha256("admin"), formerly shipped
SENTRYLOG_LEGACY_PASSWORD_SECRET="cloverstack-sentrylog-secret-minimum-16-chars"                    # formerly shipped fallback

_env_get() {  # _env_get <file> <KEY>
    [[ -f "$1" ]] || return 0
    grep -E "^$2=" "$1" | tail -n1 | cut -d= -f2-
}

_env_set() {  # _env_set <file> <KEY> <VALUE>
    local file="$1" key="$2" val="$3" tmp
    tmp="$(mktemp "${file}.XXXXXX")"
    chmod 600 "${tmp}"
    [[ -f "${file}" ]] && grep -vE "^${key}=" "${file}" > "${tmp}" || true
    printf '%s=%s\n' "${key}" "${val}" >> "${tmp}"
    mv -f "${tmp}" "${file}"
    chmod 600 "${file}"
}

ensure_sentrylog_secrets() {
    local env="${CLOVERSTACK_ROOT}/modules/sentrylog/.env"
    local pwfile="${CLOVERSTACK_CONFIG}/sentrylog-initial-password"
    local sha secret pw

    sha="$(_env_get "${env}" SENTRYLOG_ROOT_SHA2)"
    if [[ -z "${sha}" || "${sha}" == "${SENTRYLOG_ADMIN_SHA256_DEFAULT}" ]]; then
        pw="$(python3 -c 'import secrets; print(secrets.token_urlsafe(15))')"
        sha="$(printf '%s' "${pw}" | sha256sum | cut -d' ' -f1)"
        _env_set "${env}" SENTRYLOG_ROOT_SHA2 "${sha}"
        mkdir -p "${CLOVERSTACK_CONFIG}"
        ( umask 077; printf 'username: admin\npassword: %s\n' "${pw}" > "${pwfile}" )
        chmod 600 "${pwfile}"
        log "SentryLog: generated a random Graylog admin password."
        log "SentryLog: read it with: sudo cat ${pwfile}"
    fi

    secret="$(_env_get "${env}" SENTRYLOG_SECRET)"
    if [[ -z "${secret}" ]]; then
        if docker volume inspect sentrylog_sentrylog-mongo-data >/dev/null 2>&1; then
            # Existing install: Graylog encrypted stored credentials with the old
            # value, so changing it would break them. Keep it, but say so.
            _env_set "${env}" SENTRYLOG_SECRET "${SENTRYLOG_LEGACY_PASSWORD_SECRET}"
            log "SentryLog: WARNING existing install still uses the old public password_secret."
            log "SentryLog: to rotate it, re-enter stored input/notification credentials afterwards."
        else
            _env_set "${env}" SENTRYLOG_SECRET "$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')"
        fi
    fi
}

ensure_module_secrets() {
    case "$1" in
        sentrylog) ensure_sentrylog_secrets ;;
    esac
}

cmd_start() {
    local mod="$1"
    local compose="${CLOVERSTACK_ROOT}/modules/${mod}/docker-compose.yml"
    if [[ -f "${compose}" ]]; then
        ensure_module_secrets "${mod}"
        log "Starting: ${mod}"
        docker compose -f "${compose}" up -d
    else
        err "No compose file for ${mod}"
        err "Module may need to be installed first"
    fi
}

cmd_stop() {
    local mod="$1"
    local compose="${CLOVERSTACK_ROOT}/modules/${mod}/docker-compose.yml"
    if [[ -f "${compose}" ]]; then
        log "Stopping: ${mod}"
        docker compose -f "${compose}" down
    fi
}

cmd_restart() {
    local mod="$1"
    cmd_stop "${mod}"
    cmd_start "${mod}"
}

cmd_logs() {
    local mod="$1"
    local compose="${CLOVERSTACK_ROOT}/modules/${mod}/docker-compose.yml"
    if [[ -f "${compose}" ]]; then
        docker compose -f "${compose}" logs -f --tail=100
    else
        err "No compose file for ${mod}"
    fi
}

cmd_info() {
    local mod="$1"
    local meta="${CLOVERSTACK_ROOT}/modules/${mod}/module.json"
    if [[ -f "${meta}" ]]; then
        echo ""
        echo "Module: $(jq -r '.display_name // .name' "${meta}")"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  Description : $(jq -r '.description' "${meta}")"
        echo "  Version     : $(jq -r '.version' "${meta}")"
        echo "  Category    : $(jq -r '.category' "${meta}")"
        echo "  Upstream    : $(jq -r '.upstream' "${meta}")"
        echo "  License     : $(jq -r '.upstream_license' "${meta}")"
        echo "  URL Path    : $(jq -r '.url_path' "${meta}")"
        echo "  Min RAM     : $(jq -r '.min_ram_mb' "${meta}") MB"
        echo "  Min Disk    : $(jq -r '.min_disk_gb' "${meta}") GB"
        echo "  Default     : $(jq -r '.default_enabled' "${meta}")"
        local gpu_req=$(jq -r '.gpu_required // false' "${meta}")
        local gpu_rec=$(jq -r '.gpu_recommended // false' "${meta}")
        [[ "${gpu_req}" == "true" ]] && echo "  GPU         : Required"
        [[ "${gpu_rec}" == "true" ]] && echo "  GPU         : Recommended"
        echo "  Ports       :"
        jq -r '.ports | to_entries[] | "    \(.key): \(.value)"' "${meta}" 2>/dev/null
        echo "  Services    :"
        jq -r '.services[]? | "    - \(.)"' "${meta}" 2>/dev/null
        echo ""
        if [[ -f "${MODULES_DIR}/${mod}.enabled" ]]; then echo "  Status: ENABLED"; else echo "  Status: DISABLED"; fi
        local compose="${CLOVERSTACK_ROOT}/modules/${mod}/docker-compose.yml"
        if [[ -f "${compose}" ]]; then
            local running=$(docker compose -f "${compose}" ps --status running -q 2>/dev/null | wc -l)
            echo "  Running containers: ${running}"
        fi
        echo ""
    else
        err "No module metadata found for: ${mod}"
        err "Check available modules: cloverstack-ctl list"
    fi
}

cmd_list() {
    echo ""
    echo "Available CloverStack Modules"
    echo "============================="
    echo ""
    echo "  netmon            Network monitoring (Zabbix)"
    echo "  sentrylog         Log management (Graylog + Wazuh)"
    echo "  myclover-vault    Password manager (Vaultwarden)"
    echo "  chappie           AI assistant (Ollama + Open WebUI)"
    echo "  chatbox-team      Shared AI API proxy (Chatbox Team)"
    echo "  anythingllm       AI chat + document workspaces (AnythingLLM)"
    echo "  clovermedia       Smart TV + streaming + DJ"
    echo "  cloversign        Digital signage"
    echo "  cloverguard       Web proxy + content filter"
    echo "  clovermine        Crypto mining"
    echo "  cloverpos         Point of sale"
    echo "  cloverdesign      AI design studio"
    echo "  cloverbot         AI support chatbot"
    echo "  cloverdrone       UAV control"
    echo "  clovermesh        Distributed mesh"
    echo "  clovermesh-radio  LoRa mesh comms"
    echo "  clovermarket      App marketplace (CloverMarket)"
    echo "  streamserver      Live streaming platform"
    echo ""
    echo "Platform (use as subcommands):"
    echo "  storage           CloverNAS storage management (ZFS, NAS, disks)"
    echo "  deploy            CloverDeploy container & VM orchestration"
    echo "  mesh              CloverMesh HA cluster management"
    echo ""
}

# --- Symlink: cloverstack-ctl -> cloverstack-setup ---------------------------
# Main dispatch
COMMAND="${1:-}"
MODULE="${2:-}"

case "${COMMAND}" in
    # Platform subcommands — delegate to dedicated scripts
    storage)    shift; exec /usr/local/bin/clovernas "$@" ;;
    deploy)     shift; exec /usr/local/bin/cloverdeploy "$@" ;;
    mesh)       shift; exec /usr/local/bin/clovermesh "$@" ;;
    # Module management
    status)     cmd_status ;;
    enable)     [[ -n "${MODULE}" ]] && cmd_enable "${MODULE}" || usage ;;
    disable)    [[ -n "${MODULE}" ]] && cmd_disable "${MODULE}" || usage ;;
    start)      [[ -n "${MODULE}" ]] && cmd_start "${MODULE}" || usage ;;
    stop)       [[ -n "${MODULE}" ]] && cmd_stop "${MODULE}" || usage ;;
    restart)    [[ -n "${MODULE}" ]] && cmd_restart "${MODULE}" || usage ;;
    logs)       [[ -n "${MODULE}" ]] && cmd_logs "${MODULE}" || usage ;;
    list)       cmd_list ;;
    info)       [[ -n "${MODULE}" ]] && cmd_info "${MODULE}" || usage ;;
    market)
        # Delegate to clovermarket-ctl
        shift
        exec clovermarket-ctl "$@"
        ;;
    *)          usage ;;
esac
