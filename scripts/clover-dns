#!/usr/bin/env bash
# =============================================================================
# clover-dns -- CloverDNS Privacy DNS Manager
# Switch DNS profiles, toggle DoT/DNSSEC, test for leaks.
# Part of mycloverOS -- your ISP sees nothing.
# =============================================================================
set -euo pipefail

VERSION="1.0.0"
PROFILES_DIR="/etc/myclover/dns-profiles"
RESOLVED_DROP="/etc/systemd/resolved.conf.d/00-cloverdns.conf"
ACTIVE_FILE="${PROFILES_DIR}/.active"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Must be root for changes
require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}Error:${NC} clover-dns requires root. Use: sudo clover-dns $*"
        exit 1
    fi
}

# Get current active profile
get_active() {
    if [ -f "${ACTIVE_FILE}" ]; then
        cat "${ACTIVE_FILE}"
    else
        echo "unknown"
    fi
}

# =============================================================================
# COMMANDS
# =============================================================================

cmd_status() {
    echo -e "${BOLD}CloverDNS Status${NC}"
    echo "============================================"

    ACTIVE=$(get_active)
    echo -e "Active profile:   ${CYAN}${ACTIVE}${NC}"

    # systemd-resolved
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        echo -e "Resolved:         ${GREEN}running${NC}"
    else
        echo -e "Resolved:         ${RED}stopped${NC}"
    fi

    # DoT status
    DOT=$(grep -oP 'DNSOverTLS=\K\S+' "${RESOLVED_DROP}" 2>/dev/null || echo "unknown")
    case "${DOT}" in
        yes)            echo -e "DNS-over-TLS:     ${GREEN}strict (enforced)${NC}" ;;
        opportunistic)  echo -e "DNS-over-TLS:     ${GREEN}opportunistic (preferred)${NC}" ;;
        no)             echo -e "DNS-over-TLS:     ${RED}disabled (plain text!)${NC}" ;;
        *)              echo -e "DNS-over-TLS:     ${YELLOW}${DOT}${NC}" ;;
    esac

    # DNSSEC
    DNSSEC=$(grep -oP 'DNSSEC=\K\S+' "${RESOLVED_DROP}" 2>/dev/null || echo "unknown")
    echo -e "DNSSEC:           ${CYAN}${DNSSEC}${NC}"

    # Current servers
    echo ""
    echo -e "${BOLD}DNS Servers:${NC}"
    resolvectl status 2>/dev/null | grep -E "DNS Servers|Current DNS|DNS Domain" | sed 's/^/  /' || \
        echo "  (could not query resolvectl)"
}

cmd_list() {
    echo -e "${BOLD}Available DNS Profiles${NC}"
    echo "============================================"

    ACTIVE=$(get_active)

    for profile_file in "${PROFILES_DIR}"/*.conf; do
        [ -f "${profile_file}" ] || continue
        NAME=$(basename "${profile_file}" .conf)
        DESC=$(head -1 "${profile_file}" | sed 's/^# //')

        if [ "${NAME}" = "${ACTIVE}" ]; then
            echo -e "  ${GREEN}* ${NAME}${NC}  ${DIM}${DESC}${NC}"
        else
            echo -e "    ${NAME}  ${DIM}${DESC}${NC}"
        fi
    done

    echo ""
    echo -e "Switch with: ${CYAN}sudo clover-dns use <profile>${NC}"
}

cmd_use() {
    require_root "$@"

    local PROFILE="${1:-}"
    if [ -z "${PROFILE}" ]; then
        echo -e "${RED}Error:${NC} Specify a profile name."
        echo "Available profiles:"
        cmd_list
        exit 1
    fi

    local PROFILE_FILE="${PROFILES_DIR}/${PROFILE}.conf"
    if [ ! -f "${PROFILE_FILE}" ]; then
        echo -e "${RED}Error:${NC} Profile '${PROFILE}' not found."
        echo "Available profiles:"
        cmd_list
        exit 1
    fi

    echo -e "Switching to ${CYAN}${PROFILE}${NC}..."

    # Copy profile to resolved drop-in
    cp "${PROFILE_FILE}" "${RESOLVED_DROP}"

    # Update active tracker
    echo "${PROFILE}" > "${ACTIVE_FILE}"

    # Restart resolved to apply
    systemctl restart systemd-resolved

    echo -e "${GREEN}[OK]${NC} DNS switched to: ${BOLD}${PROFILE}${NC}"
    echo ""

    # Show new servers
    sleep 1
    resolvectl status 2>/dev/null | grep -E "DNS Servers|Current DNS" | sed 's/^/  /' || true
}

cmd_strict() {
    require_root "$@"

    echo -e "Setting DNS-over-TLS to ${BOLD}strict${NC} mode..."
    echo -e "${YELLOW}Warning:${NC} Captive portals (hotel/airport WiFi) may not work."

    sed -i 's/^DNSOverTLS=.*/DNSOverTLS=yes/' "${RESOLVED_DROP}"
    systemctl restart systemd-resolved

    echo -e "${GREEN}[OK]${NC} DoT is now ${BOLD}strict${NC} -- plain DNS will be refused."
}

cmd_opportunistic() {
    require_root "$@"

    echo "Setting DNS-over-TLS to opportunistic mode..."

    sed -i 's/^DNSOverTLS=.*/DNSOverTLS=opportunistic/' "${RESOLVED_DROP}"
    systemctl restart systemd-resolved

    echo -e "${GREEN}[OK]${NC} DoT is now ${BOLD}opportunistic${NC} -- TLS preferred, plain as fallback."
}

cmd_off() {
    require_root "$@"

    echo -e "${YELLOW}Warning:${NC} Disabling encrypted DNS. Your ISP will see all DNS queries."
    read -r -p "Are you sure? [y/N] " confirm
    if [[ "${confirm}" =~ ^[Yy]$ ]]; then
        sed -i 's/^DNSOverTLS=.*/DNSOverTLS=no/' "${RESOLVED_DROP}"
        systemctl restart systemd-resolved
        echo -e "${RED}[WARN]${NC} DoT disabled. DNS queries are now in plain text."
    else
        echo "Cancelled."
    fi
}

cmd_test() {
    clover-dns-test "$@"
}

cmd_custom() {
    require_root "$@"

    local PRIMARY="${1:-}"
    local FALLBACK="${2:-}"
    local DOT_HOST="${3:-}"

    if [ -z "${PRIMARY}" ]; then
        echo "Usage: sudo clover-dns custom <primary_ip> [fallback_ip] [dot_hostname]"
        echo ""
        echo "Examples:"
        echo "  sudo clover-dns custom 1.1.1.1"
        echo "  sudo clover-dns custom 1.1.1.1 9.9.9.9"
        echo "  sudo clover-dns custom 1.1.1.1 9.9.9.9 cloudflare-dns.com"
        exit 1
    fi

    echo -e "Setting custom DNS: primary=${CYAN}${PRIMARY}${NC}"

    local DNS_LINE="${PRIMARY}"
    local FALLBACK_LINE=""

    if [ -n "${DOT_HOST}" ]; then
        DNS_LINE="${PRIMARY}#${DOT_HOST}"
    fi
    if [ -n "${FALLBACK}" ]; then
        FALLBACK_LINE="FallbackDNS=${FALLBACK}"
    fi

    cat > "${RESOLVED_DROP}" <<EOF
# Custom DNS -- configured via clover-dns custom
[Resolve]
DNS=${DNS_LINE}
${FALLBACK_LINE}
DNSOverTLS=opportunistic
DNSSEC=allow-downgrade
Cache=yes
DNSStubListener=yes
ReadEtcHosts=yes
EOF

    echo "custom" > "${ACTIVE_FILE}"
    systemctl restart systemd-resolved

    echo -e "${GREEN}[OK]${NC} Custom DNS applied."
}

cmd_reset() {
    require_root "$@"

    echo "Resetting to default (Cloudflare + Quad9)..."
    cmd_use cloudflare
}

cmd_help() {
    echo -e "${BOLD}CloverDNS${NC} v${VERSION} -- Privacy-First DNS Manager"
    echo ""
    echo -e "${BOLD}USAGE${NC}"
    echo "  clover-dns <command> [options]"
    echo ""
    echo -e "${BOLD}COMMANDS${NC}"
    echo "  status              Show current DNS configuration"
    echo "  list                List available DNS profiles"
    echo "  use <profile>       Switch to a DNS profile (requires sudo)"
    echo "  strict              Enforce DNS-over-TLS (block plain DNS)"
    echo "  opportunistic       Prefer DoT but allow plain DNS fallback"
    echo "  off                 Disable encrypted DNS (not recommended)"
    echo "  custom <ip> [fb]    Set custom DNS server(s)"
    echo "  test [--external]   Run DNS privacy verification"
    echo "  reset               Reset to default (Cloudflare)"
    echo "  help                Show this help"
    echo ""
    echo -e "${BOLD}PROFILES${NC}"
    echo "  cloudflare          Fastest, zero-logging, KPMG-audited"
    echo "  quad9               Swiss non-profit, malware blocking"
    echo "  adguard             Blocks ads + trackers at DNS level"
    echo "  adguard-family      Ads + trackers + adult content filter"
    echo "  controld            Customizable filtering, no-logging"
    echo "  cloudflare-family   Malware + adult content blocking"
    echo "  max-privacy         Strict DoT + DNSSEC enforced"
    echo ""
    echo -e "${BOLD}EXAMPLES${NC}"
    echo "  sudo clover-dns use quad9        # Switch to Quad9"
    echo "  sudo clover-dns strict           # Enforce encrypted DNS"
    echo "  clover-dns test                  # Verify DNS privacy"
    echo "  clover-dns status                # Show current config"
}

# =============================================================================
# MAIN
# =============================================================================
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "${COMMAND}" in
    status)         cmd_status ;;
    list|ls)        cmd_list ;;
    use|switch)     cmd_use "$@" ;;
    strict)         cmd_strict "$@" ;;
    opportunistic)  cmd_opportunistic "$@" ;;
    off|disable)    cmd_off "$@" ;;
    test|check)     cmd_test "$@" ;;
    custom)         cmd_custom "$@" ;;
    reset|default)  cmd_reset "$@" ;;
    help|--help|-h) cmd_help ;;
    version|--version|-v) echo "CloverDNS v${VERSION}" ;;
    *)
        echo -e "${RED}Unknown command:${NC} ${COMMAND}"
        cmd_help
        exit 1
        ;;
esac
