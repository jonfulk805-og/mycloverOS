#!/bin/bash
# =============================================================================
# cloverstack-firewall — Manage UFW rules for all CloverStack services
# Usage:
#   cloverstack-firewall open [module|all]   Open ports for module(s)
#   cloverstack-firewall close [module|all]  Close ports for module(s)
#   cloverstack-firewall status              Show all CloverStack UFW rules
#   cloverstack-firewall list                List modules and their ports
# =============================================================================
set -e

# --- Port map for built-in CloverStack modules ---
declare -A MODULE_PORTS
MODULE_PORTS=(
    [chappie]="8083/tcp"
    [anythingllm]="8097/tcp"
    [chatbox-team]="8095/tcp"
    [myclover-vault]="8082/tcp 3012/tcp"
    [netmon]="8081/tcp 10051/tcp"
    [sentrylog]="9000/tcp 1514/tcp 1514/udp 9001/tcp"
    [cloverbot]="8089/tcp"
    [cloverdesign]="8088/tcp"
    [cloverdrone]="8090/tcp 8554/tcp 14550/udp 14551/udp 8890/udp"
    [cloverguard]="53/tcp 53/udp 8085/tcp 3128/tcp"
    [clovermarket]="8090/tcp"
    [clovermedia]="8096/tcp 4533/tcp"
    [clovermesh]="8091/tcp 8092/tcp 51821/udp"
    [clovermesh-radio]="8093/tcp 1884/tcp"
    [clovermine]="8086/tcp"
    [cloverpos]="8087/tcp"
    [cloversign]="8084/tcp"
    [streamserver]="8094/tcp 1935/tcp 8555/tcp 8888/tcp 8889/tcp 9710/tcp"
)

# --- Module display names ---
declare -A MODULE_NAMES
MODULE_NAMES=(
    [chappie]="Chappie AI (Open WebUI)"
    [anythingllm]="AnythingLLM"
    [chatbox-team]="Chatbox Team Proxy"
    [myclover-vault]="MyClover Vault"
    [netmon]="NetMon (Zabbix)"
    [sentrylog]="SentryLog (Graylog+Wazuh)"
    [cloverbot]="CloverBot"
    [cloverdesign]="CloverDesign"
    [cloverdrone]="CloverDrone"
    [cloverguard]="CloverGuard (DNS+Proxy)"
    [clovermarket]="CloverMarket"
    [clovermedia]="CloverMedia (Jellyfin+Navidrome)"
    [clovermesh]="CloverMesh (WireGuard)"
    [clovermesh-radio]="CloverMesh Radio (LoRa)"
    [clovermine]="CloverMine"
    [cloverpos]="CloverPOS"
    [cloversign]="CloverSign"
    [streamserver]="StreamServer (RTMP/WebRTC)"
)

# --- System service ports (always open) ---
SYSTEM_PORTS="22/tcp 80/tcp 443/tcp 7777/tcp 9443/tcp 11434/tcp 6901:6920/tcp"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()  { echo -e "${GREEN}[cloverstack-firewall]${NC} $*"; }
warn() { echo -e "${YELLOW}[cloverstack-firewall]${NC} $*"; }
err()  { echo -e "${RED}[cloverstack-firewall]${NC} $*" >&2; }

cmd_open() {
    local target="$1"
    if [[ -z "${target}" ]]; then
        echo "Usage: cloverstack-firewall open <module|all>"
        echo "Run 'cloverstack-firewall list' to see available modules."
        exit 1
    fi

    if [[ "${target}" == "all" ]]; then
        # Open system ports first
        log "Opening system ports..."
        for port in ${SYSTEM_PORTS}; do
            ufw allow ${port} comment "CloverOS System" 2>/dev/null || true
        done
        ufw allow from 172.16.0.0/12 comment "Docker-internal" 2>/dev/null || true

        for module in "${!MODULE_PORTS[@]}"; do
            open_module "${module}"
        done
        log "All ports opened. Run 'ufw status' to verify."
    else
        if [[ -z "${MODULE_PORTS[$target]+x}" ]]; then
            err "Unknown module: ${target}"
            echo "Run 'cloverstack-firewall list' to see available modules."
            exit 1
        fi
        open_module "${target}"
    fi
}

open_module() {
    local module="$1"
    local name="${MODULE_NAMES[$module]:-$module}"
    local ports="${MODULE_PORTS[$module]}"
    log "Opening ports for ${name}..."
    for port in ${ports}; do
        ufw allow ${port} comment "CloverStack: ${name}" 2>/dev/null || true
        echo "  ✓ ${port}"
    done
}

cmd_close() {
    local target="$1"
    if [[ -z "${target}" ]]; then
        echo "Usage: cloverstack-firewall close <module|all>"
        exit 1
    fi

    if [[ "${target}" == "all" ]]; then
        for module in "${!MODULE_PORTS[@]}"; do
            close_module "${module}"
        done
        log "All module ports closed. System ports (SSH, HTTP, HTTPS, Hub) untouched."
    else
        if [[ -z "${MODULE_PORTS[$target]+x}" ]]; then
            err "Unknown module: ${target}"
            exit 1
        fi
        close_module "${target}"
    fi
}

close_module() {
    local module="$1"
    local name="${MODULE_NAMES[$module]:-$module}"
    local ports="${MODULE_PORTS[$module]}"
    log "Closing ports for ${name}..."
    for port in ${ports}; do
        ufw delete allow ${port} 2>/dev/null || true
        echo "  ✗ ${port}"
    done
}

cmd_status() {
    echo ""
    echo -e "${CYAN}=== CloverStack Firewall Status ===${NC}"
    echo ""
    ufw status numbered 2>/dev/null | grep -i "clover\|docker\|SSH\|HTTP\|Ollama\|Desktop" || echo "  No CloverStack rules found"
    echo ""
}

cmd_list() {
    echo ""
    echo -e "${CYAN}=== CloverStack Modules & Ports ===${NC}"
    echo ""
    printf "  %-22s %-35s %s\n" "MODULE" "NAME" "PORTS"
    printf "  %-22s %-35s %s\n" "------" "----" "-----"
    for module in $(echo "${!MODULE_PORTS[@]}" | tr ' ' '\n' | sort); do
        local name="${MODULE_NAMES[$module]:-$module}"
        local ports="${MODULE_PORTS[$module]}"
        printf "  %-22s %-35s %s\n" "${module}" "${name}" "${ports}"
    done
    echo ""
    echo -e "  ${YELLOW}System ports (always open):${NC} ${SYSTEM_PORTS}"
    echo ""
    echo "  Usage: sudo cloverstack-firewall open <module|all>"
    echo ""
}

# --- Main dispatch ---
CMD="${1:-}"
shift 2>/dev/null || true

case "${CMD}" in
    open)   cmd_open "$@" ;;
    close)  cmd_close "$@" ;;
    status) cmd_status ;;
    list)   cmd_list ;;
    *)
        echo "CloverStack Firewall Manager"
        echo ""
        echo "Usage: cloverstack-firewall <command> [module]"
        echo ""
        echo "Commands:"
        echo "  open   <module|all>   Open UFW ports for a module or all modules"
        echo "  close  <module|all>   Close UFW ports for a module or all modules"
        echo "  status                Show current CloverStack UFW rules"
        echo "  list                  List all modules and their ports"
        ;;
esac
